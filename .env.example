# Kit inicial — Projeto "Minha Nuvem"
#
#   cp .env.example .env     e TROQUE TODAS AS SENHAS ABAIXO
#
# ATENÇÃO: o arquivo .env NUNCA vai para o Git (RNF04).
# Confira se o .gitignore já o ignora antes do primeiro commit.
# Segredo versionado zera o item correspondente da rubrica.
#
# Para gerar senhas fortes:
#   openssl rand -base64 32

# ---- Domínio e proxy -------------------------------------------------
# Local: localhost   |   Nuvem: seu domínio real (ex.: nuvem.exemplo.br)
APP_DOMAIN=localhost
MAX_UPLOAD=2GB

# ---- Armazenamento de objetos (MinIO / compatível com S3) ------------
# O usuário raiz é a "conta de administrador" do armazenamento.
# Boa prática que vale ponto: crie uma credencial de aplicação com
# permissão restrita a um único bucket e use ELA na aplicação.
MINIO_ROOT_USER=troque_este_usuario
MINIO_ROOT_PASSWORD=troque_esta_senha_agora
S3_BUCKET=arquivos
S3_REGION=us-east-1

# ---- Banco de metadados ----------------------------------------------
POSTGRES_USER=nuvem
POSTGRES_PASSWORD=troque_esta_senha_tambem
POSTGRES_DB=nuvem

# ---- Aplicação --------------------------------------------------------
# Chave usada para assinar sessões/tokens e os links temporários (RF11).
APP_SECRET=troque_por_uma_chave_longa_e_aleatoria

# Cota padrão de cada usuário novo, em MB (RF12).
COTA_PADRAO_MB=1024
