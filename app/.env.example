# Kit inicial — Projeto "Minha Nuvem"
#
#   cp .env.example .env     e TROQUE TODAS AS SENHAS ABAIXO
#
# ATENÇÃO: o arquivo .env NUNCA vai para o Git (RNF04).
# Confira se o .gitignore já o ignora antes do primeiro commit.
# Segredo versionado zera o item correspondente da rubrica.
#
# Para gerar senhas fortes:
#   openssl rand -base64 32

# ---- Banco de dados ----------------------------------------------
DATABASE_URL=postgresql://nuvem:changeme@localhost:5432/nuvem

# ---- Execução -----------------------------------------------------
NODE_ENV=development
PORT=8000

# ---- Autenticação -------------------------------------------------
BETTER_AUTH_SECRET="replace-this-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:8000"

# Set both Google credentials to enable Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
