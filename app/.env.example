DATABASE_URL=postgresql://nuvem:changeme@localhost:5432/nuvem

NODE_ENV=development
PORT=8000

BETTER_AUTH_SECRET="replace-this-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:8000"

# Set both Google credentials to enable Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Defaults to app/.data (absolute path derived from the working directory).
# Set an absolute private path for persistent deployments.
# STORAGE_ROOT="/srv/silverbox/files"
MAX_UPLOAD_BYTES=1073741824
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
# STORAGE_ROOT and STORAGE_MAX_BYTES must be explicitly set in production.
STORAGE_MAX_BYTES=10737418240
STORAGE_MIN_FREE_BYTES=5368709120
STORAGE_MIN_FREE_PERCENT=10
STORAGE_MIN_FREE_INODES=1024
STORAGE_MAX_TRANSFERS=4
STORAGE_MAX_USER_TRANSFERS=2
