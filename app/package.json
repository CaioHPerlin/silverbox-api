{
  "name": "silverbox-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Silverbox cloud storage project",
  "license": "ISC",
  "author": "TADS 6 (2026/2)",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:emit": "prisma contract emit",
    "format": "prettier src prisma.config.ts --write"
  },
  "dependencies": {
    "better-auth": "1.7.6",
    "express": "5.2.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.0",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "prettier": "3.9.9",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.28.2": true
  }
}
