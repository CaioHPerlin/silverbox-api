# Copy to /home/perlin/silverbox/api/.env, chmod 600. Never commit real values.
API_HOST=api.silverbox.perlin.com.br
WEB_HOST=silverbox.perlin.com.br
# CORS público; autenticação e isolamento de arquivos continuam obrigatórios.
CORS_ALLOW_ALL_ORIGINS=true
# Opcional: origens confiáveis do Better Auth, separadas por vírgula.
# FRONTEND_ORIGINS=https://silverbox.perlin.com.br
# Generate each independently: openssl rand -hex 32 (hex password is URL-safe).
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STORAGE_MAX_BYTES=10737418240
STORAGE_MIN_FREE_BYTES=104857600
STORAGE_MIN_FREE_PERCENT=0
STORAGE_MIN_FREE_INODES=1024
STORAGE_MAX_TRANSFERS=4
STORAGE_MAX_USER_TRANSFERS=2
MAX_UPLOAD_BYTES=1073741824
